# MySQL (Render will give you a connection string, or use PlanetScale/Railway/local)
DATABASE_URL=mysql+pymysql://user:password@host:3306/resume_analyzer

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - your deployed frontend URL
FRONTEND_ORIGIN=http://localhost:5173

# Where Chroma persists its local vector index
CHROMA_PERSIST_DIR=./chroma_data
